<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bulk_import" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/bulk_import_description" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <Spinner android:id="@+id/spinnerImportCategory" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:paddingStart="10dp" android:paddingEnd="10dp" />
    <EditText android:id="@+id/inputImportText" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:gravity="top|start" android:hint="@string/bulk_import_hint" android:inputType="textMultiLine" android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal">
        <Button android:id="@+id/buttonImportCancel" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@android:color/transparent" android:text="@string/cancel" android:textAllCaps="false" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/buttonImportSave" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button_primary" android:text="@string/import_items" android:textAllCaps="false" android:textColor="@color/button_primary_text" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
