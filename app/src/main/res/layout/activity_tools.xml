<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/tools"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_accent_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/progress_panel" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/textProgressPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/accent" android:textSize="24sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/progressOverall" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" />
            <TextView android:id="@+id/textProgressCounts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/textProgressMoney" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/travel_mode" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/travel_mode_description" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchTravelMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" />
        </LinearLayout>

        <Button android:id="@+id/buttonBulkImport" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_secondary" android:text="@string/bulk_import" android:textAllCaps="false" android:textColor="@color/accent" android:textStyle="bold" />
        <Button android:id="@+id/buttonTemplates" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary" android:text="@string/templates" android:textAllCaps="false" android:textColor="@color/accent" android:textStyle="bold" />
        <Button android:id="@+id/buttonArchived" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button_secondary" android:text="@string/archived_categories" android:textAllCaps="false" android:textColor="@color/accent" android:textStyle="bold" />
        <Button android:id="@+id/buttonShareAll" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button_primary" android:text="@string/share_all" android:textAllCaps="false" android:textColor="@color/button_primary_text" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
